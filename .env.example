# ── Entorno ──────────────────────────────────────────────────────────────────
# local | preview | staging | production
APP_ENV=local
# URL base de la app: callbacks de Mercado Pago, links de emails y QR públicos
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase (proyecto PROPIO de Ninja Food, no el del POS) ──────────────────
# Local: valores que imprime `pnpm db:start`. Cloud: Settings → API del proyecto.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secreta: solo server-side / Edge Functions. NUNCA exponer con prefijo NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# ── Mercado Pago (suscripciones preapproval) ─────────────────────────────────
# Sandbox en local/preview; credenciales productivas solo en Vercel production.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# Secreto para validar firma de webhooks MP
MERCADOPAGO_WEBHOOK_SECRET=

# ── Emails (sistema calcado del POS: Edge Function send_email + SMTP) ────────
# La config SMTP vive en la tabla system_email_smtp (solo service_role): host,
# puerto, usuario, password, from. NO va en este archivo.
# Aquí solo el remitente por defecto (referencia humana / footer):
EMAIL_FROM="Ninja Food <no-reply@ninjasoft.app>"
# La Edge Function send_email usa SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY, que
# Supabase inyecta automáticamente en funciones deployadas. No requiere secrets
# propios. El disparo desde la app usa SUPABASE_SERVICE_ROLE_KEY (arriba).

# ── Cron (Vercel Cron) ───────────────────────────────────────────────────────
# Secreto que protege los handlers de app/api/cron/*. Vercel inyecta
# automaticamente "Authorization: Bearer ${CRON_SECRET}" en los requests de cron
# cuando esta env var existe en el proyecto. Sin header valido los endpoints
# responden 401. SETEAR EN VERCEL (Project Settings -> Environment Variables) con
# un valor aleatorio largo, ej: openssl rand -hex 32. En local dejar vacio (los
# crons no corren localmente; para probarlos a mano pasar el header manualmente).
CRON_SECRET=

# ── Observabilidad (opcional en local) ───────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── IA (fase 7 — key de PLATAFORMA, nunca del cliente) ───────────────────────
# Clave para cifrar (AES-256-GCM) la API key de IA (Claude/Gemini) guardada en
# internal_settings (key 'ai_config'). DEBE ser 32 bytes en hex (64 chars).
# Generar con: openssl rand -hex 32. Sin esta var, la IA queda DESHABILITADA
# (getAIConfig() devuelve null, nunca rompe). SETEAR EN VERCEL (server-side,
# NUNCA con prefijo NEXT_PUBLIC). La API key concreta se carga desde /internal.
AI_CONFIG_SECRET=

# ── Internacional (fase 4 — dejar vacías hasta entonces) ─────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ── Dev ──────────────────────────────────────────────────────────────────────
# Override de feature flags en desarrollo, ej: {"haccp":true}
NEXT_PUBLIC_FEATURE_FLAGS_OVERRIDE=
